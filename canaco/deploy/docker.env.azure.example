# Copia como canaco/deploy/docker.env en la VM y rellena secretos únicos.
DJANGO_SECRET_KEY=replace-with-a-new-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=canacotgfg.mexicocentral.cloudapp.azure.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://canacotgfg.mexicocentral.cloudapp.azure.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

DB_NAME=canaco
DB_USER=canaco
DB_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_LARGA_Y_ALEATORIA

# Caddy usa HTTP-01 / TLS-ALPN para solicitar y renovar el certificado.
CADDYFILE=canaco/deploy/Caddyfile
HTTP_PORT=80
HTTPS_PORT=443
IMAGE=ghcr.io/juliotrugardev/proyectocanaco
IMAGE_TAG=latest