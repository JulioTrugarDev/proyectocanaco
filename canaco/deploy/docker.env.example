# Copy this to canaco/deploy/docker.env for a local Docker run.
# Replace both values before running; never upload docker.env to GitHub.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,canacotgfg.mexicocentral.cloudapp.azure.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://canacotgfg.mexicocentral.cloudapp.azure.com
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

DB_NAME=canaco
DB_USER=canaco
DB_PASSWORD=replace-this-local-database-password

# Local access uses http://localhost:8080. Set to 80 on Azure after the cutover.
HTTP_PORT=8080
IMAGE=ghcr.io/juliotrugardev/proyectocanaco
IMAGE_TAG=latest
CADDYFILE=canaco/deploy/Caddyfile.local
HTTPS_PORT=8443
